-- ========== SERVIDOR ==========
local function serverHop()
    notify("Procurando servidor vazio...")
    task.spawn(function()
        local success, servers = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            local response = game:HttpGet(url)
            return HttpService:JSONDecode(response)
        end)
        if success and servers and servers.data then
            local bestServer = nil
            local lowestPlayers = math.huge
            for _, server in pairs(servers.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    if server.playing < lowestPlayers then
                        lowestPlayers = server.playing
                        bestServer = server
                    end
                end
            end
            if bestServer then
                notify("Teleportando para servidor com " .. bestServer.playing .. " jogadores...")
                task.wait(1.5)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, bestServer.id, player)
            else
                notify("Nenhum servidor vazio encontrado!")
            end
        else
            notify("Erro ao buscar servidores!")
        end
    end)
end

-- ========== VERIFICAR ADMIN ==========
local function checkAdminInServer()
    local adminFound = false
    local adminNames = {}
    local adminTools = {
        "BanHammer", "Admin", "Mod", "Ban", "Kick", "Handcuffs",
        "Fly", "Teleport", "God", "HealAll", "KillAll", "AdminPanel"
    }
    local adonisDetected = false
    pcall(function()
        if ReplicatedStorage:FindFirstChild("ADONIS") or 
           ReplicatedStorage:FindFirstChild("Adonis") or
           ReplicatedStorage:FindFirstChild("HDAdmin") or
           Workspace:FindFirstChild("ADONIS") then
            adonisDetected = true
        end
    end)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local backpack = p:FindFirstChild("Backpack")
            if backpack then
                for _, tool in pairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        for _, adminName in pairs(adminTools) do
                            if string.find(string.lower(tool.Name), string.lower(adminName)) then
                                adminFound = true
                                table.insert(adminNames, p.Name .. " (Tool: " .. tool.Name .. ")")
                            end
                        end
                    end
                end
            end
            if p.Character then
                for _, tool in pairs(p.Character:GetChildren()) do
                    if tool:IsA("Tool") then
                        for _, adminName in pairs(adminTools) do
                            if string.find(string.lower(tool.Name), string.lower(adminName)) then
                                adminFound = true
                                table.insert(adminNames, p.Name .. " (Tool: " .. tool.Name .. ")")
                            end
                        end
                    end
                end
                local nameLower = string.lower(p.Name)
                if string.find(nameLower, "admin") or string.find(nameLower, "mod") or 
                   string.find(nameLower, "dev") or string.find(nameLower, "owner") then
                    adminFound = true
                    table.insert(adminNames, p.Name .. " (Nome suspeito)")
                end
            end
        end
    end
    return adminFound, adminNames, adonisDetected
end

-- ========== PLAYER LIST ==========
local function getPlayerList()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local dist = "N/A"
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp and myHRP then
                dist = math.floor((hrp.Position - myHRP.Position).Magnitude) .. "m"
            end
            table.insert(list, p.Name .. " | " .. (p.Team and p.Team.Name or "Sem time") .. " | " .. dist)
        end
    end
    return list
end

-- ========== COPY PLAYER ==========
local function copyPlayer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then notify("Jogador nao encontrado!") return end
    if not target.Character then notify("Jogador sem personagem!") return end

    local char = player.Character
    if not char then notify("Aguarde personagem!") return end

    -- Copiar roupas
    for _, item in pairs(target.Character:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then
            local clone = item:Clone()
            clone.Parent = char
        end
        if item:IsA("Accessory") then
            local clone = item:Clone()
            clone.Parent = char
        end
    end

    -- Copiar cores do corpo
    local targetHum = target.Character:FindFirstChild("Humanoid")
    local myHum = char:FindFirstChild("Humanoid")
    if targetHum and myHum then
        myHum.BodyTypeScale = targetHum.BodyTypeScale
        myHum.BodyDepthScale = targetHum.BodyDepthScale
        myHum.BodyWidthScale = targetHum.BodyWidthScale
        myHum.BodyHeightScale = targetHum.BodyHeightScale
        myHum.HeadScale = targetHum.HeadScale
    end

    notify("Apariencia copiada de " .. targetName)
end

