    pcall(function() remote:FireServer(unpack(args)) end)
end

-- Fly TP: sobe alto, vai ate a posicao, desce na coordenada
local function flyTeleportTo(targetPos, jobName)
    local _, hrp, hum = getChar()
    if not hrp or not hum then notify("Sem personagem!") return false end

    -- Ativa fly se nao estiver ativo
    local wasFlying = flying
    if not flying then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bodyVel.Parent = hrp
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bodyGyro.Parent = hrp
        flying = true
    end

    -- 1. SOBE ALTO (evita paredes)
    notify("Subindo alto...")
    local highPos = hrp.Position + Vector3.new(0, farmFlyHeight, 0)
    local startTime = tick()
    while tick() - startTime < 3 do
        if not flying or not bodyVel then break end
        local dir = (highPos - hrp.Position).Unit
        bodyVel.Velocity = dir * 150
        bodyGyro.CFrame = CFrame.lookAt(hrp.Position, highPos)
        task.wait(0.03)
    end

    -- 2. VOA ATE A POSICAO NO ALTO
    notify("Voando ate " .. jobName .. " (alto)...")
    local flyTarget = Vector3.new(targetPos.X, targetPos.Y + farmFlyHeight, targetPos.Z)
    startTime = tick()
    while tick() - startTime < 5 do
        if not flying or not bodyVel then break end
        local dist = (hrp.Position - flyTarget).Magnitude
        if dist < 10 then break end
        local dir = (flyTarget - hrp.Position).Unit
        bodyVel.Velocity = dir * 200
        bodyGyro.CFrame = CFrame.lookAt(hrp.Position, flyTarget)
        task.wait(0.03)
    end

    -- 3. DESCE NA COORDENADA EXATA
    notify("Descendo em " .. jobName .. "...")
    local finalTarget = targetPos + Vector3.new(0, 5, 0)
    startTime = tick()
    while tick() - startTime < 4 do
        if not flying or not bodyVel then break end
        local dist = (hrp.Position - finalTarget).Magnitude
        if dist < 5 then break end
        local dir = (finalTarget - hrp.Position).Unit
        bodyVel.Velocity = dir * 120
        bodyGyro.CFrame = CFrame.lookAt(hrp.Position, finalTarget)
        task.wait(0.03)
    end

    -- Para o personagem
    if bodyVel then bodyVel.Velocity = Vector3.zero end

    -- Se nao estava voando antes, desativa
    if not wasFlying then
        task.wait(0.5)
        if bodyVel then bodyVel:Destroy() bodyVel = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
        flying = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end

    notify("Chegou em: " .. jobName)
    return true
end

local function runFarmLoop()
    task.spawn(function()
        while farmLoopEnabled do
            local job = jobs[currentJobIndex]
            if not job then currentJobIndex = 1 job = jobs[1] end
            if not farmLoopEnabled then break end

            notify("[FARM] Iniciando: " .. job.name)
            startJob(job.jobId)
            task.wait(math.random(2, 4))

            if not farmLoopEnabled then break end

            notify("[FARM] Indo para: " .. job.name)
            local success = flyTeleportTo(job.pos, job.name)
            if not success then
                notify("[FARM] Erro no fly, pulando...")
            end

            -- Espera na entrega
            task.wait(math.random(4, 6))

            if not farmLoopEnabled then break end

            currentJobIndex = currentJobIndex + 1
            if currentJobIndex > #jobs then currentJobIndex = 1 end

            task.wait(math.random(2, 4))
        end
    end)
end

-- Farm manual individual (tambem usa fly alto)
local function manualFarmJob(job)
    startJob(job.jobId)
    task.wait(1.5)
    flyTeleportTo(job.pos, job.name)
end

