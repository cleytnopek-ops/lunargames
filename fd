-- ========== ESP COMPLETO ==========
local espBoxEnabled = false
local espNameEnabled = false
local espLineEnabled = false
local espDistanceEnabled = false
local espSkeletonEnabled = false
local espChamsEnabled = false
local espColor = Color3.fromRGB(255, 50, 50)
local espTeamCheck = false
local espStorage = {}
local espConnection = nil

local function clearESP()
    for _, data in pairs(espStorage) do
        pcall(function()
            if data.box then data.box:Destroy() end
            if data.name then data.name:Destroy() end
            if data.line then
                if data.line.beam then data.line.beam:Destroy() end
                if data.line.att0 then data.line.att0:Destroy() end
                if data.line.att1 then data.line.att1:Destroy() end
            end
            if data.distance then data.distance:Destroy() end
            if data.skeleton then
                for _, line in pairs(data.skeleton) do
                    pcall(function() line:Destroy() end)
                end
            end
            if data.chams then
                for _, cham in pairs(data.chams) do
                    pcall(function() cham:Destroy() end)
                end
            end
        end)
    end
    espStorage = {}
end

local function isTeammate(targetPlayer)
    if not espTeamCheck then return false end
    if targetPlayer.Team and player.Team then
        return targetPlayer.Team == player.Team
    end
    return false
end

local skeletonJoints = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

local function updateESP()
    if not (espBoxEnabled or espNameEnabled or espLineEnabled or espDistanceEnabled or espSkeletonEnabled or espChamsEnabled) then
        clearESP()
        return
    end
    local myChar, myHRP = getChar()
    if not myHRP then clearESP() return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if not hrp or not head then continue end
            if isTeammate(p) then continue end

            local data = espStorage[p]
            if not data then data = {} espStorage[p] = data end
            local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)

            -- BOX ESP
            if espBoxEnabled then
                if not data.box or not data.box.Parent then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Size = hrp.Size + Vector3.new(2, 3, 1)
                    box.Adornee = hrp
                    box.Color3 = espColor
                    box.Transparency = 0.6
                    box.AlwaysOnTop = true
                    box.ZIndex = 5
                    box.Parent = hrp
                    data.box = box
                else
                    data.box.Color3 = espColor
                end
            elseif data.box then
                pcall(function() data.box:Destroy() end)
                data.box = nil
            end

            -- NAME ESP
            if espNameEnabled then
                local displayText = p.Name
                if espDistanceEnabled then
                    displayText = p.Name .. " [" .. dist .. "m]"
                end
                if not data.name or not data.name.Parent then
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "GH_ESP_Name"
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 200, 0, 40)
                    bg.StudsOffset = Vector3.new(0, 2.8, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = head
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = displayText .. " [" .. math.floor(hum and hum.Health or 0) .. "/" .. math.floor(hum and hum.MaxHealth or 100) .. "]"
                    lbl.TextColor3 = espColor
                    lbl.TextStrokeTransparency = 0.4
                    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
                    lbl.TextSize = 13
                    lbl.Font = Enum.Font.GothamBold
                    lbl.Parent = bg
                    data.name = bg
                else
                    local lbl = data.name:FindFirstChildOfClass("TextLabel")
                    if lbl then
                        lbl.Text = displayText .. " [" .. math.floor(hum and hum.Health or 0) .. "/" .. math.floor(hum and hum.MaxHealth or 100) .. "]"
                        lbl.TextColor3 = espColor
                    end
                end
            elseif data.name then
                pcall(function() data.name:Destroy() end)
                data.name = nil
            end

            -- DISTANCE ONLY (se name estiver desativado)
            if espDistanceEnabled and not espNameEnabled then
                if not data.distance or not data.distance.Parent then
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "GH_ESP_Dist"
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 100, 0, 20)
                    bg.StudsOffset = Vector3.new(0, 1.5, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = head
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = dist .. "m"
                    lbl.TextColor3 = espColor
                    lbl.TextStrokeTransparency = 0.4
                    lbl.TextSize = 12
                    lbl.Font = Enum.Font.GothamBold
                    lbl.Parent = bg
                    data.distance = bg
                else
                    local lbl = data.distance:FindFirstChildOfClass("TextLabel")
                    if lbl then lbl.Text = dist .. "m" lbl.TextColor3 = espColor end
                end
            elseif data.distance then
                pcall(function() data.distance:Destroy() end)
                data.distance = nil
            end

            -- LINE ESP
            if espLineEnabled and myHRP then
                if not data.line or not data.line.beam or not data.line.beam.Parent then
                    local att0 = Instance.new("Attachment")
                    att0.Position = Vector3.new(0, 0, 0)
                    att0.Parent = myHRP
                    local att1 = Instance.new("Attachment")
                    att1.Position = Vector3.new(0, 0, 0)
                    att1.Parent = hrp
                    local beam = Instance.new("Beam")
                    beam.Attachment0 = att0
                    beam.Attachment1 = att1
                    beam.Color = ColorSequence.new(espColor)
                    beam.Width0 = 0.1
                    beam.Width1 = 0.1
                    beam.FaceCamera = true
                    beam.LightEmission = 1
                    beam.LightInfluence = 0
                    beam.Parent = myHRP
                    data.line = {beam = beam, att0 = att0, att1 = att1}
                else
                    data.line.beam.Color = ColorSequence.new(espColor)
                end
            elseif data.line then
                pcall(function()
                    if data.line.beam then data.line.beam:Destroy() end
                    if data.line.att0 then data.line.att0:Destroy() end
                    if data.line.att1 then data.line.att1:Destroy() end
                end)
                data.line = nil
            end

            -- SKELETON ESP
            if espSkeletonEnabled then
                if not data.skeleton then data.skeleton = {} end
                local idx = 1
                for _, joint in pairs(skeletonJoints) do
                    local p1 = p.Character:FindFirstChild(joint[1])
                    local p2 = p.Character:FindFirstChild(joint[2])
                    if p1 and p2 then
                        local line = data.skeleton[idx]
                        if not line or not line.Parent then
                            line = Instance.new("Beam")
                            line.Width0 = 0.05
                            line.Width1 = 0.05
                            line.Color = ColorSequence.new(espColor)
                            line.LightEmission = 1
                            line.LightInfluence = 0
                            line.FaceCamera = true
                            line.Parent = Workspace.Terrain
                            data.skeleton[idx] = line
                        end
                        local a0 = line:FindFirstChild("A0") or Instance.new("Attachment")
                        a0.Name = "A0"
                        a0.Parent = p1
                        local a1 = line:FindFirstChild("A1") or Instance.new("Attachment")
                        a1.Name = "A1"
                        a1.Parent = p2
                        line.Attachment0 = a0
                        line.Attachment1 = a1
                        line.Color = ColorSequence.new(espColor)
                        idx = idx + 1
                    end
                end
                -- cleanup extra lines
                while data.skeleton[idx] do
                    pcall(function() data.skeleton[idx]:Destroy() end)
                    data.skeleton[idx] = nil
                    idx = idx + 1
                end
            elseif data.skeleton then
                for _, line in pairs(data.skeleton) do
                    pcall(function() line:Destroy() end)
                end
                data.skeleton = nil
            end

            -- CHAMS ESP
            if espChamsEnabled then
                if not data.chams then data.chams = {} end
                local idx = 1
                for _, part in pairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        local cham = data.chams[idx]
                        if not cham or not cham.Parent then
                            cham = Instance.new("BoxHandleAdornment")
                            cham.AlwaysOnTop = true
                            cham.ZIndex = 2
                            cham.Parent = part
                            data.chams[idx] = cham
                        end
                        cham.Size = part.Size
                        cham.Adornee = part
                        cham.Color3 = espColor
                        cham.Transparency = 0.7
                        idx = idx + 1
                    end
                end
                while data.chams[idx] do
                    pcall(function() data.chams[idx]:Destroy() end)
                    data.chams[idx] = nil
                    idx = idx + 1
                end
            elseif data.chams then
                for _, cham in pairs(data.chams) do
                    pcall(function() cham:Destroy() end)
                end
                data.chams = nil
            end

        else
            if espStorage[p] then
                pcall(function()
                    local d = espStorage[p]
                    if d.box then d.box:Destroy() end
                    if d.name then d.name:Destroy() end
                    if d.line then
                        if d.line.beam then d.line.beam:Destroy() end
                        if d.line.att0 then d.line.att0:Destroy() end
                        if d.line.att1 then d.line.att1:Destroy() end
                    end
                    if d.distance then d.distance:Destroy() end
                    if d.skeleton then
                        for _, line in pairs(d.skeleton) do pcall(function() line:Destroy() end) end
                    end
                    if d.chams then
                        for _, cham in pairs(d.chams) do pcall(function() cham:Destroy() end) end
                    end
                end)
                espStorage[p] = nil
            end
        end
    end
end

local function startESP()
    if espConnection then espConnection:Disconnect() end
    espConnection = RunService.Heartbeat:Connect(function()
        if espBoxEnabled or espNameEnabled or espLineEnabled or espDistanceEnabled or espSkeletonEnabled or espChamsEnabled then
            updateESP()
        else
            clearESP()
        end
    end)
end

